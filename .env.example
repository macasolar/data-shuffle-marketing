# Copy to .env and fill in. Never commit .env.

# Where the website repo is checked out, for runs on this machine. Inside the
# container it is always /work/website, mounted from WEBSITE_HOST_PATH.
WEBSITE_REPO=/home/maca/git/data-shuffle/website-data-shuffle

# Claude auth: the subscription token from `claude setup-token`. Leave it
# empty on a machine where Claude Code is already signed in. Do NOT also set
# ANTHROPIC_API_KEY: if both are set, `ds run` refuses to start, because the
# API key would win silently and bill per token.
CLAUDE_CODE_OAUTH_TOKEN=

# Model for the content runs. Opus for writing, which is the whole point of
# this repo; a cheaper model shows in the copy.
MARKETING_MODEL=claude-opus-5-5

# Optional: where run records and logs go (default: runs/ in this repo).
# RUNS_DIR=

# --- Docker only (compose.yaml), see docs/SERVER.md ---
# Host path of the website checkout, mounted at /work/website.
WEBSITE_HOST_PATH=
# Folder with the deploy key (id_ed25519) and known_hosts.
SSH_DIR=
# `id -u` of the host user that owns the checkouts.
HOST_UID=1000
