#!/usr/bin/env bash
# Bumps the patch version on every commit and includes it in that same commit,
# as the website repo does. version.txt is the only place the version lives:
# pyproject.toml reads it (dynamic version) and uv.lock does not record it.
# Enable once per clone with:  git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
git_dir=$(git rev-parse --git-dir)

# Not in the middle of a merge or a rebase: those commits are not content
# changes, and bumping them only causes conflicts in version.txt.
if [ -f "$git_dir/MERGE_HEAD" ] || [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
  exit 0
fi

current=$(tr -d '[:space:]' < version.txt)
if ! [[ "$current" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "pre-commit: version.txt holds \"$current\", expected something like 0.2.1" >&2
  exit 1
fi
next="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.$((BASH_REMATCH[3] + 1))"
echo "$next" > version.txt
git add version.txt
echo "version $current -> $next"
